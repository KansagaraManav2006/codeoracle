# ==============================================================================
# CodeOracle Root Environment Configuration (Template)
# Shared development and deployment settings across services.
# Copy to .env and customize as needed.
# ==============================================================================

# Core Project Metadata
APP_NAME=CodeOracle
VERSION=0.1.0
ENVIRONMENT=development

# Server Host and Ports
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=5173

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
