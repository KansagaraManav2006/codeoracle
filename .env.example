# Application Settings
APP_NAME=CodeOracle
VERSION=0.1.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# SQLite Database (Deterministic path resolution; default data dir is backend/data/)
# CODEORACLE_DATA_DIR=backend/data
DATABASE_URL=sqlite:///./codeoracle.db

# CORS Configuration (Commas-separated or list in config)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# Ingestion & Security Thresholds
MAX_ZIP_COMPRESSED_BYTES=209715200 # 200MB
MAX_ZIP_UNCOMPRESSED_BYTES=524288000 # 500MB
MAX_FILE_BYTES=52428800 # 50MB
MAX_ZIP_ENTRIES=10000
MAX_COMPRESSION_RATIO=100.0
MAX_RELEVANT_LINES=100000
CLONE_TIMEOUT_SECONDS=150
MAX_CLONE_SIZE_BYTES=524288000 # 500MB

# Generated tests are syntax-checked by default. Enable only in a stronger sandbox.
TEST_EXECUTION_ENABLED=false
TEST_EXECUTION_ALLOW_UNTRUSTED=false
TEST_EXECUTION_TIMEOUT_SECONDS=20
TEST_EXECUTION_MAX_OUTPUT_BYTES=65536
TEST_EXECUTION_MAX_ITERATIONS=2

# LLM Provider Configuration (Optional for static analysis)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
