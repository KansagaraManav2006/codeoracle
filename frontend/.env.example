# ==============================================================================
# CodeOracle Frontend Environment Configuration (Template)
# Public browser-safe variables only. Must start with VITE_ prefix.
# Never place database credentials, session secrets, or OAuth secrets here.
# ==============================================================================

# API Base URL (leave empty to use relative /api proxy via Vite in development)
VITE_API_URL=

# Public Application Metadata
VITE_APP_NAME=CodeOracle
VITE_APP_VERSION=0.1.0
