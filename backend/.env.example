# ==============================================================================
# CodeOracle Backend Environment Configuration (Template)
# Server-only settings: database, auth, sessions, thresholds, OAuth secrets.
# Never expose these variables to the browser or commit real secrets.
# ==============================================================================

# Database Settings
DATABASE_URL=sqlite:///./codeoracle.db

# Authentication & Session Security
# Generate a strong random key in production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
SESSION_COOKIE_NAME=codeoracle_session
SESSION_DURATION_DAYS=30

# Cookie Security Configuration:
# - In local development over HTTP, cookies default to secure=False.
# - In production or when FRONTEND_URL starts with https://, cookies default to secure=True.
# - Set SESSION_COOKIE_SECURE=true explicitly behind HTTPS reverse proxies (e.g. Render, AWS, Nginx).
# - Options: true, false, or leave empty for auto-detection.
SESSION_COOKIE_SECURE=

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# Google OAuth 2.0 Credentials (Server-side only)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# - Authorized JavaScript Origin: http://localhost:5173 (dev) or https://your-domain.com (prod)
# - Authorized Redirect URI: must EXACTLY match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Ingestion Limits & Security Thresholds
MAX_ZIP_COMPRESSED_BYTES=209715200 # 200MB
MAX_ZIP_UNCOMPRESSED_BYTES=524288000 # 500MB
MAX_FILE_BYTES=52428800 # 50MB
MAX_ZIP_ENTRIES=10000
MAX_COMPRESSION_RATIO=100.0
MAX_RELEVANT_LINES=100000
CLONE_TIMEOUT_SECONDS=300
MAX_CLONE_SIZE_BYTES=524288000 # 500MB

# Generated-test Execution (Untrusted code execution is disabled by default)
TEST_EXECUTION_ENABLED=false
TEST_EXECUTION_ALLOW_UNTRUSTED=false
TEST_EXECUTION_TIMEOUT_SECONDS=20
TEST_EXECUTION_MAX_OUTPUT_BYTES=65536
TEST_EXECUTION_MAX_ITERATIONS=2

# Workspaces & Temporary Storage
WORKSPACES_DIR=workspaces
TEMP_STORAGE_DIR=temp_storage

# Optional LLM Integration (Static AST analysis does not require an LLM)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
